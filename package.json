{
  "name": "portego",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational smart-home digital twin, gateway, and MCP control plane",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm lint:api && pnpm typecheck && pnpm test && pnpm test:api && pnpm build",
    "dev": "docker compose up --build",
    "dev:web": "pnpm --filter @portego/web dev",
    "dev:api": "uv run --project apps/api uvicorn portego_api.main:app --reload --host 0.0.0.0 --port 4000",
    "dev:gateway": "pnpm --filter @portego/gateway-agent dev",
    "gateway:discover": "pnpm --filter @portego/gateway-cli discover",
    "portego": "pnpm --filter @portego/gateway-cli exec tsx src/index.ts gateway",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:api": "uv run --project apps/api ruff check apps/api",
    "test": "turbo run test",
    "test:api": "uv run --project apps/api pytest -q",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
