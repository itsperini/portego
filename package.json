{
  "name": "portego",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational smart-home digital twin, gateway, and MCP control plane",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @portego/web dev",
    "dev:server": "pnpm --filter @portego/server dev",
    "dev:gateway": "pnpm --filter @portego/gateway-agent dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
